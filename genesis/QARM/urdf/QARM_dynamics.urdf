<?xml version="1.0" encoding="utf-8" ?>

<!-- Description du robot QARM -->

<robot name="QARM">

    <!--
        Inertial parameters documented here are the static URDF values used by the simulator.
        The symbols referenced below come from dynamics.py:
        L1..L5, lc1..lc4, m1..m4, I1A..I4L, beta = atan(L3 / L2).
    -->

    <link name="world" />

    <!-- Joint 0 -->
    <joint name="world_base_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="world" />
        <child link="base_link" />
    </joint>

    <link name="base_link">
        <!-- Base link parameters are kept from the CAD/document set.
             dynamics.py does not define a base-link mass/inertia tuple. -->
        <inertial>
            <origin xyz="0.000529200576288575 -2.23307396420992E-06 0.0267852902177001" rpy="0 0 0" />
            <mass value="3.89847036294307" />
            <inertia ixx="0.0259717926187233" ixy="7.41706820354147E-07" ixz="-9.20327430275286E-08" iyy="0.0237418182185852" iyz="6.90408382921997E-11" izz="0.048730018421969" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://QARM/meshes/base_link.STL" />
            </geometry>
            <material name="">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://QARM/meshes/base_link.STL" />
            </geometry>
        </collision>
    </link>

    <!-- Joint 1 -->
    <joint name="YAW" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="YAW" />
        <axis xyz="0 0 1" />
        <limit lower="-2.967" upper="2.967" effort="100.0" velocity="1.57" />
        <dynamics damping="0.2" friction="0.1" />
    </joint>

    <link name="YAW">
        <!-- Articulation yaw -> correspond à l'axe de rotation de la base autour de z -->
        <inertial>
            <!-- COM verification from dynamics.py:
                 beta = atan(L3 / L2) = 0.141897054604164
                 COM = [0, 0, L1 - lc1]
                     = [0, 0, 0.1400 - 0.0399]
                     = [0, 0, 0.100100000000000]
                 mass = m1 = 0.7906
                 inertia uses the link-1 constants I1A and I1L from dynamics.py. -->
            <origin xyz="0 0 0.1001" rpy="0 0 0" />
            <mass value="0.7906" />
            <inertia ixx="1.556E-03" ixy="0.0" ixz="0.0" iyy="1.489E-03" iyz="0.0" izz="9.624E-04" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://QARM/meshes/YAW.STL" />
            </geometry>
            <material name="">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://QARM/meshes/YAW.STL" />
            </geometry>
        </collision>
    </link>

    <!-- Joint 2 -->
    <joint name="SHOULDER" type="revolute">
        <origin xyz="0 0 0.1400" rpy="-1.5707963267949 0 0" />
        <parent link="YAW" />
        <child link="BICEP" />
        <axis xyz="0 0 1" />
        <limit lower="-1.483" upper="1.483" effort="100.0" velocity="1.57" />
    </joint>

    <link name="BICEP">
    <!-- Articulation shoulder -->
        <inertial>
            <!-- COM verification from dynamics.py:
                 dynamics.py provides the physical scalars m2, lc2, L2, L3 and beta, but the
                 URDF inertial origin is the COM state expressed in the BICEP link frame after
                 the CAD/URDF frame transform.
                 Recalculation used here (axis model from URDF geometry):
                     l2 = sqrt(L2^2 + L3^2)
                     u2 = [L3, -L2, 0] / l2
                     p_COM = (l2 - lc2) * u2
                           = [0.03485377274698415, -0.24397640922888905, 0]
                 Previous state in this file was:
                     [0.0136584263393359, -0.234778864037209, -7.06001931450219E-05]
                 Delta(old - new):
                     [-0.021195346407648252, 0.009197545191680062, -7.06001931450219E-05]
                     ||delta|| = 0.023105032596395028
                 Parameter check against dynamics.py:
                     beta = atan(L3 / L2) = 0.141897054604164
                     l2 = sqrt(L2^2 + L3^2) = 0.353553390593274
                     lc2 = 0.1071
                 mass = m2 = 0.4591
                 inertia uses the link-2 constants I2A and I2L from dynamics.py. -->
              <!-- Ancienne valeur: <origin xyz="0.0136584263393359 -0.234778864037209 -7.06001931450219E-05" rpy="0 0 0" /> -->
            <origin xyz="0.03485377274698415 -0.24397640922888905 0" rpy="0 0 0" />
            <mass value="0.4591" />
            <inertia ixx="1.922E-04" ixy="0.0" ixz="0.0" iyy="9.541E-03" iyz="0.0" izz="9.610E-03" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://QARM/meshes/BICEP.STL" />
            </geometry>
            <material name="">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://QARM/meshes/BICEP.STL" />
            </geometry>
        </collision>
    </link>

    <!-- Joint 3 (Do not correspond to the coordonates système 3 of the doc 7. Dynamic Parameters) -->
    <joint name="ELBOW" type="revolute">
        <origin xyz="0.0500 -0.3500 0" rpy="0 0 -1.42889927219074" />
        <parent link="BICEP" />
        <child link="FOREARM" />
        <axis xyz="0 0 1" />
        <limit lower="-1.658" upper="1.309" effort="100.0" velocity="1.57" />
    </joint>

    <link name="FOREARM">
        <inertial>
            <!-- COM verification from dynamics.py:
                 dynamics.py provides the physical scalars m3, lc3, L4 and L5, but the URDF
                 inertial origin is the COM state expressed in the FOREARM link frame after the
                 CAD/URDF frame transform.
                 Recalculation used here (axis model from URDF geometry):
                     wrist_offset = [0.0336611536380097, 0.235607569369425, 0]
                     u3 = wrist_offset / ||wrist_offset||
                     p_COM = lc3 * u3
                           = [0.022077756649173268, 0.15453084695729807, 0]
                 Previous state in this file was:
                     [0.0372712542033594, 0.155357218514742, 0.000271723941997439]
                 Delta(old - new):
                     [0.015193497554186135, 0.0008263715574439168, 0.000271723941997439]
                     ||delta|| = 0.015218380064273167
                 Parameter check against dynamics.py:
                     lc3 = 0.1561
                 mass = m3 = 0.269
                 inertia uses the link-3 constants I3A and I3L from dynamics.py. -->
            <!-- Ancienne valeur: <origin xyz="0.0372712542033594 0.155357218514742 0.000271723941997439" rpy="0 0 0" /> -->
            <origin xyz="0.022077756649173268 0.15453084695729807 0" rpy="0 0 0" />
            <mass value="0.269" />
            <inertia ixx="2.069E-03" ixy="0.0" ixz="0.0" iyy="1.976E-03" iyz="0.0" izz="2.679E-04" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://QARM/meshes/FOREARM.STL" />
            </geometry>
            <material name="">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://QARM/meshes/FOREARM.STL" />
            </geometry>
        </collision>
    </link>

    <!-- Joint 4 (Do not correspond to the coordonates système 3 of the doc 7. Dynamic Parameters) -->
    <joint name="WRIST" type="revolute">
        <origin xyz="0.0336611536380097 0.235607569369425 0" rpy="-1.5707963267949 0 -0.141897054604159" />
        <parent link="FOREARM" />
        <child link="END_EFFECTOR" />
        <axis xyz="0 0 1" />
        <limit lower="-2.792" upper="2.792" effort="100.0" velocity="1.57" />
    </joint>

    <!-- ATTENTION CECI N'EST PAS L'END EFFECTOR REEL DU ROBOT QARM, la masse total et l'inertie correspondent néanmoins à la masse et l'inertie de l'end effector réel -->
    <link name="END_EFFECTOR">
        <inertial>
            <!-- COM verification from dynamics.py:
                 COM = [0, 0, L5 - lc4]
                     = [0, 0, 0.1500 - 0.0998]
                     = [0, 0, 0.050200000000000]
                 mass = m4 = 0.257
                 inertia uses the link-4 constants I4A and I4L from dynamics.py. -->
            <!-- Ancienne valeur: <origin xyz="0 0 0.050199999999999995" rpy="0 0 0" /> -->
            <origin xyz="0 0 0.0502" rpy="0 0 0" />
            <mass value="0.257" />
            <inertia ixx="1.120E-03" ixy="0" ixz="0" iyy="9.994E-04" iyz="0" izz="6.528E-04" />
        </inertial>
        <visual>
            <origin xyz="0 0 0.075" rpy="0 0 0" />
            <!--<geometry><box size="0.02 0.10 0.15" /></geometry>-->
            <geometry><box size="0.02 0.10 0.15" /></geometry>
            <material name="Black"><color rgba="0.1 0.1 0.1 1" /></material>
        </visual>
        <collision>
            <origin xyz="0 0 0.075" rpy="0 0 0" />
            <geometry><box size="0.02 0.10 0.15" /></geometry>
        </collision>
    </link>




</robot>