<?xml version="1.0" encoding="utf-8" ?>

<!-- Description du robot QARM -->

<robot name="QARM">

    <link name="world" />

    <!-- Joint 0 -->
    <joint name="world_base_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="world" />
        <child link="base_link" />
    </joint>

    <link name="base_link">
        <!-- Valeur issue du document 7. Dynamic Parameters -->
        <inertial>
            <origin xyz="0.000529200576288575 -2.23307396420992E-06 0.0267852902177001" rpy="0 0 0" />
            <mass value="3.89847036294307" />
            <inertia ixx="0.0259717926187233" ixy="7.41706820354147E-07" ixz="-9.20327430275286E-08" iyy="0.0237418182185852" iyz="6.90408382921997E-11" izz="0.048730018421969" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="../meshes/base_link.STL" />
            </geometry>
            <material name="">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="../meshes/base_link.STL" />
            </geometry>
        </collision>
    </link>

    <!-- Joint 1 -->
    <joint name="YAW" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="YAW" />
        <axis xyz="0 0 1" />
        <limit lower="-2.967" upper="2.967" effort="100.0" velocity="1.57" />
        <dynamics damping="0.1516" friction="0.2150" />
    </joint>

    <link name="YAW">
        <!-- Articulation yaw -> correspond à l'axe de rotation de la base autour de z -->
        <inertial>
            <origin xyz="0 0 0.1001" rpy="0 0 0" />
            <mass value="0.7906" />
            <inertia ixx="1.556E-03" ixy="0.0" ixz="0.0" iyy="1.489E-03" iyz="0.0" izz="9.624E-04" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="../meshes/YAW.STL" />
            </geometry>
            <material name="">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="../meshes/YAW.STL" />
            </geometry>
        </collision>
    </link>

    <!-- Joint 2 -->
    <joint name="SHOULDER" type="revolute">
        <origin xyz="0 0 0.1400" rpy="-1.5707963267949 0 0" />
        <parent link="YAW" />
        <child link="BICEP" />
        <axis xyz="0 0 1" />
        <limit lower="-1.483" upper="1.483" effort="100.0" velocity="1.57" />
        <dynamics damping="0.0443" friction="0.43" />
    </joint>

    <link name="BICEP">
    <!-- Articulation shoulder -->
        <inertial>
            <!-- Valeur issue du document 7. Dynamic Parameters -->
            <origin xyz="0.03485377274698415 -0.24397640922888905 0.0" rpy="0 0 0" />
            <mass value="0.4591" />
            <inertia ixx="1.922E-04" ixy="0.0" ixz="0.0" iyy="9.541E-03" iyz="0.0" izz="9.610E-03" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="../meshes/BICEP.STL" />
            </geometry>
            <material name="">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
        </visual>
        <!--<visual>-->
            <!--<origin xyz="0.03485377274698415 -0.24397640922888905 0.0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.001" radius="0.01"/>
            </geometry>
            <material name="">
                <color rgba="1. 0. 0. 1" />
            </material>
        </visual>-->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="../meshes/BICEP.STL" />
            </geometry>
        </collision>
    </link>

    <!-- Joint 3 (Do not correspond to the coordonates système 3 of the doc 7. Dynamic Parameters) -->
    <joint name="ELBOW" type="revolute">
        <origin xyz="0.0500 -0.3500 0" rpy="0 0 -1.42889927219074" />
        <parent link="BICEP" />
        <child link="FOREARM" />
        <axis xyz="0 0 1" />
        <limit lower="-1.658" upper="1.309" effort="100.0" velocity="1.57" />
        <dynamics damping="0.001" friction="0.4799" />
    </joint>

    <link name="FOREARM">
        <inertial>
            <origin xyz="0.022075873708644018 0.1545311159605081 0." rpy="0 0 0" />
            <!-- <origin xyz="0.0372712542033594 0.155357218514742 0.000271723941997439" rpy="0 0 0" /> -->
            <mass value="0.269" />
            <inertia ixx="2.069E-03" ixy="0.0" ixz="0.0" iyy="1.976E-03" iyz="0.0" izz="2.679E-04" />
        </inertial>
        <!--<visual>-->
            <!--<origin xyz="0.022075873708644018 0.1545311159605081 0." rpy="0 0 0" />-->
            <!--<origin xyz="0.03535533905932738 0.24748737341529164 0.0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.001" radius="0.01"/>
            </geometry>
            <material name="">
                <color rgba="1. 0. 0. 1" />
            </material>
        </visual>-->
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="../meshes/FOREARM.STL" />
            </geometry>
            <material name="">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="../meshes/FOREARM.STL" />
            </geometry>
        </collision>
    </link>

    <!-- Joint 4 (Do not correspond to the coordonates système 3 of the doc 7. Dynamic Parameters) -->
    <joint name="WRIST" type="revolute">
        <origin xyz="0.03535533905932738 0.24748737341529164 0.0" rpy="-1.5707963267949 0 -0.141897054604159" />
        <parent link="FOREARM" />
        <child link="END_EFFECTOR_BASE" />
        <axis xyz="0 0 1" />
        <limit lower="-2.792" upper="2.792" effort="100.0" velocity="1.57" />
        <dynamics damping="0.0182" friction="0.0307" />
    </joint>

    <!-- ATTENTION CECI N'EST PAS L'END EFFECTOR REEL DU ROBOT QARM, la masse total et l'inertie correspondent néanmoins à la masse et l'inertie de l'end effector réel -->
   <link name="END_EFFECTOR_BASE">
        <inertial>
            <origin xyz="0 0 0.050199999999999995" rpy="0 0 0" />
            <mass value="0.257" />
            <inertia ixx="1.120E-03" ixy="0" ixz="0" iyy="9.994E-04" iyz="0" izz="6.528E-04" />
        </inertial>
        <visual>
            <origin xyz="0 0 0.075" rpy="0 0 0" />
            <geometry><box size="0.02 0.10 0.15" /></geometry>
            <material name="Black"><color rgba="0.1 0.1 0.1 1" /></material>
        </visual>
        <collision>
            <origin xyz="0 0 0.075" rpy="0 0 0" />
            <geometry><box size="0.02 0.10 0.15" /></geometry>
        </collision>
    </link>

<!-- See https://github.com/quanser/urdf_representations/tree/main/qarm_gripper for the original urdf representation of the gripper (it will not work here, hence the modifications). We put almost all the weight and inertia in the gripper base -->

